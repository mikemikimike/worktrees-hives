{
  "schema_version": 1,
  "research_id": "structured-contract-first-pass-evidence-v1",
  "question": "Does a frozen pre-execution contract improve evidence quality from cloud coding agents compared with issue text alone?",
  "hypothesis": "Adding a structured research contract increases first-pass valid evidence by at least 10 percentage points without increasing median input tokens by more than 15 percent.",
  "null_hypothesis": "A structured research contract does not improve first-pass valid evidence within the token-cost bound.",
  "independent_variable": "task_context_format",
  "dependent_metrics": [
    "first_pass_valid_evidence_rate",
    "acceptance_criteria_pass_rate",
    "median_input_tokens",
    "median_wall_time_seconds"
  ],
  "baselines": [
    "issue_text_only"
  ],
  "arms": [
    "issue_text_plus_frozen_research_contract"
  ],
  "acceptance_criteria": [
    "first_pass_valid_evidence_rate_delta >= 0.10",
    "acceptance_criteria_pass_rate_delta >= 0.05",
    "median_input_tokens_relative_delta <= 0.15"
  ],
  "failure_criteria": [
    "paired_task_completion_rate < 0.90",
    "independent_verification_coverage < 1.00"
  ],
  "resource_budget": {
    "max_agent_runs": 40,
    "max_parallel_runs": 4,
    "max_wall_time_minutes": 240,
    "max_input_tokens": 2000000
  },
  "seed_policy": {
    "strategy": "fixed_per_task",
    "seeds": [
      104729,
      130363,
      155921,
      196613
    ],
    "reuse_across_arms": true
  },
  "split_policy": {
    "unit": "repository_task",
    "development_task_ids": [
      "python-validation-01",
      "json-envelope-02"
    ],
    "evaluation_task_ids": [
      "schema-compatibility-03",
      "artifact-contract-04"
    ]
  },
  "repo": "acme/agent-eval-harness",
  "ref": "8f4c2d91a6b753e0c18d2a946f0b73e5a1c29d84",
  "artifact_expectations": [
    "contracts/input-contracts.jsonl",
    "metrics/paired-run-metrics.json",
    "reports/independent-verification.md"
  ]
}
